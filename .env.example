# Optional Docker setup. Copy to .env.local-stack, then run npm run local:up.
# The launcher fills blank passwords/tokens and refreshes the model digest.
# Never commit .env.local-stack. These values belong only to your local stack.
LOCAL_DB_PASSWORD=
LOCAL_COLLECTOR_TOKEN=
LOCAL_LAB_HOST_TOKEN=
LOCAL_ADMIN_EMAIL=admin@sentinel.local
LOCAL_ADMIN_PASSWORD=
LOCAL_FRONTEND_PORT=5180
LOCAL_API_PORT=8100
LOCAL_DB_PORT=55432

# Optional AI incident summaries. Detection works without these.
LOCAL_OPENROUTER_API_KEY=
LOCAL_OPENROUTER_MODEL=openrouter/free

# Computed from backend/artifacts by the launcher; do not paste secrets here.
LOCAL_MODEL_SHA256=
LOCAL_MODEL_THRESHOLD=0.525
