ENVIRONMENT=development
DATABASE_URL=postgresql://sentinel:CHANGE_ME@127.0.0.1:55432/sentinel_local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(48))"
COLLECTOR_TOKEN=
MODEL_PATH=artifacts/model.joblib
MODEL_SHA256=f07c491db78db97fa29e053efd3506c610568797194e611ca984df8a518a0fc3
DETECTION_THRESHOLD=0.525
MINIMUM_ATTACK_PACKETS=100
MITIGATION_ENABLED=false
RETENTION_DAYS=7
SESSION_HOURS=8
LOG_LEVEL=INFO
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Public registration creates an approved administrator of a new private workspace.
REGISTRATION_ENABLED=true
# Google OAuth web client; keep the secret on the backend only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8100/api/auth/google/callback

# Trusted managed lab host. Generate a long random secret; never expose to clients.
LAB_HOST_TOKEN=
LAB_HOST_ID=mac-research-host
LAB_CAPACITY=2
LAB_SESSION_MINUTES=60
LAB_IDLE_MINUTES=15
LAB_START_TIMEOUT_SECONDS=180
