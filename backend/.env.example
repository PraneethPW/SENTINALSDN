ENVIRONMENT=development
DATABASE_URL=postgresql://user:password@your-neon-host/neondb?sslmode=require
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(48))"
COLLECTOR_TOKEN=
MODEL_PATH=artifacts/model.joblib
MODEL_SHA256=694d18c4e4d28ddb729a4d73ff004a206310c15f965d0e33d6bc8d9c6af8adb8
DETECTION_THRESHOLD=0.525
MINIMUM_ATTACK_PACKETS=100
MITIGATION_ENABLED=false
RETENTION_DAYS=7
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Public registration creates an approved administrator of a new private workspace.
REGISTRATION_ENABLED=true
# Google OAuth web client; keep the secret on the backend only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5180/api/auth/google/callback

# Trusted managed lab host. Generate a long random secret; never expose to clients.
LAB_HOST_TOKEN=
LAB_HOST_ID=mac-research-host
LAB_CAPACITY=2
LAB_SESSION_MINUTES=60
LAB_IDLE_MINUTES=15
LAB_START_TIMEOUT_SECONDS=180
