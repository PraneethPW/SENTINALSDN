# Local development and Docker use the same-origin API proxy.
# VITE_* values are public and embedded into production JavaScript.
VITE_API_URL=
# Vite development server only. Change this if the native API uses another port.
API_PROXY_TARGET=http://127.0.0.1:8100
# Vercel: set VITE_API_URL=https://your-api.up.railway.app in project settings.
