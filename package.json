{
  "name": "sentinel-sdn",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Measured SDN telemetry, machine learning detection, and a live defense console.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/local.mjs up",
    "build": "npm --prefix frontend run build",
    "infra:plan": "cd backend && npx --yes @railway/cli@5.71.0 config plan",
    "infra:apply": "cd backend && npx --yes @railway/cli@5.71.0 config apply",
    "local:up": "node scripts/local.mjs up",
    "local:down": "node scripts/local.mjs down",
    "local:status": "node scripts/local.mjs status",
    "local:logs": "node scripts/local.mjs logs",
    "local:credentials": "node scripts/local.mjs credentials",
    "dev:ui": "npm --prefix frontend run dev"
  },
  "devDependencies": {
    "railway": "3.16.0"
  }
}
